# Deploy target: LocalStack (docker compose up -d). Safe to commit: no real secrets.
REGION=us-east-1
STAGE_NAME=dev
LOCALSTACK_ENDPOINT=http://localhost.localstack.cloud:4566

# Every FN_ENV_* variable becomes a Lambda environment variable (prefix removed).
# Lambda containers run on the roomres_net Docker network, so use service names, not localhost.
FN_ENV_STAGE=local
FN_ENV_DATABASE_URL=postgresql://postgres:password@db:5432/platform
FN_ENV_ALLOWED_ORIGINS=http://localhost:5173
FN_ENV_AWS_ENDPOINT_URL=http://localstack:4566
FN_ENV_S3_BUCKET=roomres-local-photos
FN_ENV_S3_PUBLIC_URL=http://localhost:4566/roomres-local-photos
# Presigned upload URLs are opened by the browser, which cannot resolve the `localstack` service name
FN_ENV_S3_PRESIGN_ENDPOINT=http://localhost:4566
# Lets LocalStack Lambdas verify the frontend's Bearer ID tokens (no API Gateway authorizer locally)
FN_ENV_COGNITO_USER_POOL_ID=us-east-1_IRgcDe04c
FN_ENV_COGNITO_CLIENT_ID=5ajt154gne7m3aeeo4d6omo197

# Where deploy.sh / photos.sh download the seeded room photos from before copying them into LocalStack
PHOTO_SOURCE_URL=https://roomreserve-image-private.s3.ap-southeast-1.amazonaws.com