# Used by `npm run dev` and the db:* scripts on your machine (copy to .env).
# Lambda functions do NOT read this file: their env comes from infra/env/<target>.env.

STAGE=local
PORT=3000
# Match DB_HOST_PORT from the root .env if you changed it
DATABASE_URL=postgresql://postgres:password@localhost:5432/platform
ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=ap-southeast-1
# Base URL for room photo links (object keys are appended to it).
# The LocalStack bucket gets its photos from `npm run photos:local` or `npm run deploy:local`;
# without LocalStack, use https://roomreserve-image-private.s3.ap-southeast-1.amazonaws.com
S3_PUBLIC_URL=http://localhost:4566/roomres-local-photos
# Room photo uploads (presigned POST) go to this LocalStack bucket; needs `docker compose up -d`
# and `npm run deploy:local` once so the bucket and its CORS rule exist. LocalStack accepts any keys.
S3_BUCKET=roomres-local-photos
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
